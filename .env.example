# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =========================================================
# FIREBASE / FIRESTORE (REQUIRED FOR PRODUCTION ON RENDER)
# =========================================================
# Paste the complete Firebase Admin service-account JSON as ONE line
# into Render Environment. Never commit a real service-account key.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"YOUR_FIREBASE_PROJECT_ID"}'

# Must exactly match serviceAccount.project_id above.
FIREBASE_EXPECTED_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"

# Firestore root collection/document used by this app.
FIREBASE_COLLECTION="hanh_pham_manager"
FIREBASE_DOCUMENT="database"

# Keep this value stable across every deploy/restart. Use a long random secret.
AUTH_TOKEN_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Studio timezone.
APP_TIMEZONE="Asia/Ho_Chi_Minh"

# Leave unset/false for an existing database. Only set true for a deliberate
# one-time initialization of a brand-new, empty Firestore project.
FIREBASE_ALLOW_EMPTY_INIT="false"

# Used only when intentionally creating the first admin in a brand-new DB.
# Set securely before the one-time initialization; never reuse demo credentials.
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD="REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS"
INITIAL_ADMIN_NAME="Quản trị viên"
INITIAL_ADMIN_EMAIL="admin@example.com"

# Render provides PORT automatically. Do not hardcode it in production.
